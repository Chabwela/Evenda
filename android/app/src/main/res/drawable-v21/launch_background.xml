<?xml version="1.0" encoding="utf-8"?>
<!-- Start-up screen: cream with the plain forest disc, exactly where the in-app
     launch screen draws the mark (22dp above centre); the app then carves the "e". -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/evenda_cream" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/launch_mark" />
    </item>
</layer-list>
